# Netlify / Cloudflare Pages read this file. Vercel uses the same rules from vercel.json.
# Android expects this exact type for app downloads.
/app/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="perfucktionist.apk"
  Cache-Control: public, max-age=300

# The Android app reads this from https://localhost to check for updates, so it needs CORS.
/app/apk.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
